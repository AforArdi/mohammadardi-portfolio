# Copy to .env.local. Never commit real credentials.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key or legacy service_role key
SUPABASE_SECRET_KEY=
OWNER_USER_ID=
OWNER_EMAIL=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=
CRON_SECRET=
# Supavisor transaction URL, custom portfolio_app login, SSL required
DATABASE_POOL_URL=
# Session/direct URL for portfolio_migrator, never used by the running app
DATABASE_MIGRATION_URL=
# Used only by the bootstrap script; do not set this in production hosting
DATABASE_ADMIN_URL=
PORTFOLIO_APP_PASSWORD=
PORTFOLIO_MIGRATOR_PASSWORD=
